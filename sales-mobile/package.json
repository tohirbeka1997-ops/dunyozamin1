{
  "name": "dunyozamin-sales-mobile",
  "version": "1.1.6",
  "private": true,
  "description": "DunyoZamin — sotuvchilar uchun enterprise mobil ilova (Expo)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 8081 --host lan",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "export-web": "expo export --platform web --output-dir dist",
    "lint": "tsc --noEmit",
    "assets:brand": "python scripts/generate-brand-assets.py",
    "build:android:local": "powershell -ExecutionPolicy Bypass -File scripts/build-android-release.ps1",
    "eas:login": "eas login",
    "eas:init": "eas init",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:ios:production": "eas build --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-camera": "~16.0.18",
    "expo-constants": "~17.0.0",
    "expo-device": "~7.0.3",
    "expo-font": "~13.0.4",
    "expo-local-authentication": "~15.0.0",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.9",
    "jsqr": "^1.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.3",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~18.3.0",
    "eas-cli": "^16.32.0",
    "typescript": "~5.6.0"
  }
}
