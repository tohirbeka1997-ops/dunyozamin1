# Staff API base URL (public-api /v1/staff/*)
# - Native / EAS builds: MUST be set to your HTTPS public-api (phone cannot use localhost).
# - Web build served by public-api (Telegram WebApp): LEAVE UNSET — the app
#   auto-uses the page origin (same-origin).
EXPO_PUBLIC_STAFF_API_URL=http://localhost:3334

# Default tenant slug (optional — pre-filled on login)
EXPO_PUBLIC_DEFAULT_TENANT=default

# Firebase (optional) — copy google-services.json.example → google-services.json
# after creating an Android app in Firebase for package com.dunyozamin.sales,
# then set android.googleServicesFile in app.json.
# EXPO_PUBLIC_FCM_PROJECT_ID=your-firebase-project-id
