{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_STAFF_API_URL": "https://staff.dunyozamin.com",
        "EXPO_PUBLIC_DEFAULT_TENANT": "default"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_STAFF_API_URL": "https://staff.dunyozamin.com",
        "EXPO_PUBLIC_DEFAULT_TENANT": "default"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_STAFF_API_URL": "https://staff.dunyozamin.com",
        "EXPO_PUBLIC_DEFAULT_TENANT": "default"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
