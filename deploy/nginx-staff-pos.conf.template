# Staff POS WebApp — generated by deploy/scripts/setup-staff-nginx.sh
# Butun vhost → public-api (static sales-mobile/dist + /v1 API + SPA fallback)

upstream staff_public_api {
    server 127.0.0.1:__UPSTREAM_PORT__;
    keepalive 16;
}

server {
    listen 80;
    server_name __STAFF_DOMAIN__;

    client_max_body_size 4m;

    # Let's Encrypt HTTP-01 (certbot) — must NOT proxy to public-api
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    # Telegram WebApp iframe (single-line CSP — multiline "\ " breaks directive names in nginx)
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https://__STAFF_DOMAIN__; frame-ancestors https://web.telegram.org https://telegram.org 'self'; base-uri 'self'; object-src 'none';" always;

    location / {
        proxy_pass http://staff_public_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
