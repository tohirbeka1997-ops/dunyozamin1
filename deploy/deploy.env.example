# Web deploy: nusxa deploy.env → deploy/deploy.env (gitga tushmaydi)
# yoki ildizdagi .env da DEPLOY_SERVER qatorlarini qo‘shing.
#
# To'liq yo'riqnoma: deploy/FULL-PRODUCTION-DEPLOY-UZ.md

# SSH (majburiy deploy:web / deploy:server / deploy:staff uchun)
DEPLOY_SERVER=user@your-server.com

# Windows: kechasi server backup yuklab olish (deploy/scripts/pull-db-from-server.ps1)
# Task Scheduler yoki qo'lda: powershell -File deploy/scripts/pull-db-from-server.ps1
# SSH_IDENTITY_FILE=%USERPROFILE%/.ssh/id_ed25519

# Maxfiy kalit (bo‘shliqli yo‘l uchun SSH_OPTS emas, shu ishlating)
# Windows: SSH_IDENTITY_FILE=%USERPROFILE%/.ssh/hetzner_pos
# yoki: SSH_IDENTITY_FILE=C:/Users/You/.ssh/id_ed25519
SSH_IDENTITY_FILE=

# Qo‘shimcha: port, StrictHostKeyChecking=accept-new va hokazo
# SSH_OPTS=-p 22 -o StrictHostKeyChecking=accept-new

# Serverdagi web root — POS admin SPA (`deploy:web`); nginx odatda /opt/pos/dist
REMOTE_PATH=/opt/pos/dist

# Telegram Mini App (mini-app/) — alohida deploy: `npm run deploy:mini-app`
# (Nginx odatda: root /opt/pos/mini-app/dist; `deploy:web` buni yubormaydi)
# MINI_APP_REMOTE_PATH=/opt/pos/mini-app/dist
# MINI_APP_RELEASES_DIR=/opt/pos/mini-app-releases
# Bir domen bo'lsa: bo'sh qoldiring. Alohida API: DEPLOY_MINI_APP_VITE_PUBLIC_API_URL=https://api.example.com

# Build va RPC (bo‘lmasa .env dagi VITE_POS_RPC_URL / VITE_POS_RPC_SECRET ishlatiladi)
# DEPLOY_API_URL=https://api.example.com
# DEPLOY_API_SECRET=serverdagi_POS_HOST_SECRET_bilan_bir_xil

# ------------------------------------------
# Server deploy (npm run deploy:server)
# ------------------------------------------
# Serverdagi loyiha katalogi (default: /opt/pos)
# DEPLOY_APP_PATH=/opt/pos
#
# Customer AR: list/getById NEVER rewrite debt_uzs / credit_amount unless set.
# Leave unset or 0 for deploy safety. Opt-in repair only: CUSTOMER_AR_HEAL=1
# CUSTOMER_AR_HEAL=0
#
# Healthcheck URL (default: http://127.0.0.1:3334/health)
# DEPLOY_HEALTH_URL=http://127.0.0.1:3334/health
#
# Deploydan keyin restart qilinadigan xizmatlar (space yoki comma bilan).
# deploy-server.cjs default: public-api + telegram-bot + pos-rpc (HTTP RPC :3333).
# Docker pos-server ham :3333 ni ochsa — systemd pos-rpc bilan ikkalasi bir vaqtda ishlamasin (EADDRINUSE).
# Docker pos-server ishlatilsa (Hetzner default): faqat public-api + bot; pos-rpc ni disable qiling.
# pos-server va public-api bir xil /var/lib/pos ni ulashi kerak (docker-compose.prod.yaml bind-mount).
# DEPLOY_RESTART_SERVICES=public-api.service telegram-bot.service
#
# Masofada RPC health (3333) tekshiruvi (Docker yo‘q RPC bo‘lsa — OK; bo‘lmasa WARN):
# DEPLOY_RPC_HEALTH_URL=http://127.0.0.1:3333/health
# DEPLOY_SKIP_RPC_HEALTH=1
#
# O‘rnatish/rebuild bayroqlari:
# default: root=1 (telegram runtime uchun), public-api=1
# DEPLOY_INSTALL_ROOT=1
# DEPLOY_INSTALL_PUBLIC_API=1
# DEPLOY_REBUILD_ROOT_NATIVE=1
# DEPLOY_REBUILD_PUBLIC_API_NATIVE=1
#
# Local precheckni o‘tkazib yuborish (default: 0)
# SKIP_DEPLOY_CHECKS=0
#
# Remote apply (npm rebuild + restart) uchun step timeout sekundlarda (default: 1800)
# DEPLOY_STEP_TIMEOUT_SEC=1800

# ------------------------------------------
# Sotuvchi POS Telegram WebApp (alohida bot)
# ------------------------------------------
# Sotuvchi POS (sales-mobile) ni Telegram Web App sifatida ochadigan YANGI bot.
# Mijoz boti (TELEGRAM_BOT_TOKEN) bilan ARALASHMAYDI.
#   STAFF_BOT_TOKEN=...           # @BotFather yangi bot tokeni (server .env ga qo'ying, gitga emas)
#   STAFF_WEB_APP_URL=https://pos.example.com   # HTTPS shart (Telegram WebApp talabi)
#   STAFF_BOT_MODE=polling        # yoki webhook
# Sotuvchi web buildini deploy qilish (Expo web export → dist):
#   npm run sales-mobile:export-web  yoki  node scripts/build-staff-web.cjs
#   → sales-mobile/dist
#   serverga static yuboring (nginx → public-api yoki to'g'ridan-to'g'ri STAFF_WEB_DIR).
# STAFF_WEB_REMOTE_PATH=/opt/pos/sales-mobile/dist
# STAFF_WEB_RELEASES_DIR=/opt/pos/sales-mobile-releases
# STAFF_WEB_APP_URL=https://staff.dunyozamin.com/
#
# Server .env (public-api) — to'liq yo'riqnoma: deploy/FULL-PRODUCTION-DEPLOY-UZ.md
# STAFF_BOT_TOKEN=
# STAFF_WEB_APP_URL=https://staff.dunyozamin.com/
# STAFF_JWT_SECRET=
# STAFF_JWT_REFRESH_SECRET=
# PUBLIC_API_DB_PATH=/var/lib/pos/tenants/default/pos.db
# STAFF_WEB_DIR=/opt/pos/sales-mobile/dist
# PUBLIC_API_TRUST_PROXY=1

# ------------------------------------------
# To'liq deploy (npm run deploy:full)
# ------------------------------------------
# DEPLOY_SKIP_WEB=1          # admin SPA deploy o'tkazish
# DEPLOY_SKIP_MINI_APP=1     # mini-app deploy o'tkazish
# DEPLOY_SKIP_STAFF=1        # staff web deploy o'tkazish
# SKIP_DEPLOY_CHECKS=1       # preflight o'tkazish (xotira yetmasa)
# TELEGRAM_WEB_APP_URL=https://app.dunyozamin.com
