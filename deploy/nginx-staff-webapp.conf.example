# =============================================================================
# Staff POS WebApp (sales-mobile) — nginx snippet
#
# Tavsiya: alohida subdomain (staff.example.com) → public-api :3334
# Expo web export asset yo'llari /_expo/ ildizdan keladi — subpath /staff/ murakkab.
#
# O'rnatish:
#   sudo nano /etc/nginx/sites-available/staff-pos.conf
#   sudo ln -s /etc/nginx/sites-available/staff-pos.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
# =============================================================================

upstream staff_public_api {
    server 127.0.0.1:3334;
    keepalive 16;
}

# =============================================================================
# Variant A (TAVSIYA): butun vhost → public-api
# public-api static (sales-mobile/dist) + /v1 API + SPA fallback bitta jarayonda
# =============================================================================
